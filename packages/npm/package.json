{
  "name": "@alephonenull/eval",
  "version": "3.0.0",
  "description": "⚠️ EXPERIMENTAL: Theoretical AI safety framework - NOT FOR PRODUCTION USE",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.mjs",
      "require": "./dist/next.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.mjs",
      "require": "./dist/express.js"
    },
    "./universal": {
      "types": "./dist/universal.d.ts",
      "import": "./dist/universal.mjs",
      "require": "./dist/universal.js"
    },
    "./v3": {
      "types": "./dist/v3/index.d.ts",
      "import": "./dist/v3/index.mjs",
      "require": "./dist/v3/index.js",
      "default": "./dist/v3/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "DISCLAIMER.md",
    "RESEARCH_ONLY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:react && npm run build:next && npm run build:express && npm run build:universal",
    "build:core": "tsup src/index.ts src/v3/index.ts --format cjs,esm --dts --splitting --clean",
    "build:v3": "tsup src/v3/index.ts --format cjs,esm --dts --out-dir dist --entry.v3=src/v3/index.ts",
    "build:all": "npm run build",
    "build:react": "tsup src/react/index.ts --format cjs,esm --dts --out-dir dist --entry.react=src/react/index.ts",
    "build:next": "tsup src/next/index.ts --format cjs,esm --dts --out-dir dist --entry.next=src/next/index.ts",
    "build:express": "tsup src/express/index.ts --format cjs,esm --dts --out-dir dist --entry.express=src/express/index.ts",
    "build:universal": "tsup src/universal.ts --format cjs,esm --dts --out-dir dist --entry.universal=src/universal.ts",
    "compile:math": "node scripts/compile-math.js",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:v3": "npm run build && node validation/v3/run-validation.mjs",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test && npm run lint",
    "release": "npm version prerelease && npm publish --access public --tag experimental"
  },
  "keywords": [
    "research",
    "experimental",
    "theoretical",
    "ai-safety",
    "llm-protection",
    "language-model-safety",
    "ai-manipulation-detection",
    "safety-framework",
    "research-only",
    "not-production"
  ],
  "author": {
    "name": "John Bernard",
    "email": "contact@alephonenull.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/purposefulmaker/alephonenull.git"
  },
  "bugs": {
    "url": "https://github.com/purposefulmaker/alephonenull/issues"
  },
  "homepage": "https://alephonenull.com",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@opendocs/eslint-config": "workspace:*",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "react": "^19.3.1",
    "terser": "^5.51.2",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "next": ">=13.0.0",
    "react": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "publishConfig": {
    "access": "public",
    "tag": "experimental"
  }
}
